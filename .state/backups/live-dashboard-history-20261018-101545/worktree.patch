+        if enable_twitter:
+            res.append("twitter")
+        if enable_reddit:
+            res.append("reddit")
+        return res
+
+    resolved = []
+    seen = set()
+    for raw in platforms:
+        p = str(raw).lower().strip()
+        p = PLATFORM_ALIASES.get(p, p)
+        if p not in CANONICAL_PLATFORMS_SET:
