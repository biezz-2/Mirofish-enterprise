{
  "hooks": {
    "PreToolUse": [
      {
        "tools": ["Bash"],
        "script": "hooks/block-blind-installs.sh"
      }
    ],
    "PostToolUse": [
      {
        "tools": ["Edit", "Write", "WriteFile", "EditFile", "ReplaceWithGitMergeDiff"],
        "script": "hooks/verify-after-edit.sh"
      }
    ],
    "Stop": [
      {
        "script": "hooks/epistemic-audit.sh"
      }
    ]
  }
}
