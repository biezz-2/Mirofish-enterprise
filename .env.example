# ==============================================================================
# MiroFish Enterprise - Environment Configuration Template (.env.example)
# Template Konfigurasi Lingkungan MiroFish Enterprise (.env.example)
#
# INSTRUCTIONS / PETUNJUK:
# 1. Copy this file to .env: `cp .env.example .env`
#    Salin berkas ini ke .env: `cp .env.example .env`
# 2. Fill in all required credentials before starting the application.
#    Isi semua kredensial yang diperlukan sebelum menjalankan aplikasi.
# 3. NEVER commit real secrets, API keys, or production passwords to git.
#    JANGAN PERNAH commit secret asli, API key, atau kata sandi produksi ke git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY / SERVER & KEAMANAN
# ------------------------------------------------------------------------------

# Flask Debug Mode [EN: Set to 'false' in production. 'true' only for local debug.]
# Mode Debug Flask [ID: Set 'false' di produksi. 'true' hanya untuk debug lokal.]
FLASK_DEBUG=false

# Development Mode Bypass [EN: MUST be 'false' in production. When true, bypasses API key checks.]
# Bypass Mode Pengembangan [ID: WAJIB bernilai 'false' di produksi. Jika true, mem-bypass pengecekan API key.]
DEVELOPMENT_MODE=false

# Application HTTP Port [EN: Port for Flask backend API server.]
# Port HTTP Aplikasi [ID: Port untuk server API backend Flask.]
PORT=8000

# Secret Key for Flask Session & Security Tokens
# [EN: REQUIRED for production. Do NOT leave empty or use 'example'/'test'.
#  Generate a secure 32-byte hex token using: python3 -c "import secrets; print(secrets.token_hex(32))"]
# Kunci Rahasia untuk Sesi Flask & Token Keamanan
# [ID: WAJIB diisi untuk produksi. JANGAN biarkan kosong atau gunakan kata 'example'/'test'.
#  Hasilkan token heksadesimal 32-byte yang aman dengan: python3 -c "import secrets; print(secrets.token_hex(32))"]
SECRET_KEY=

# AES-256-GCM Envelope Encryption Master Key
# [EN: Master passphrase for encrypting sensitive credentials in the MiroFish vault.
#  Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"]
# Kunci Utama Enkripsi Envelope AES-256-GCM
# [ID: Passphrase master untuk mengenkripsi kredensial sensitif di vault MiroFish.
#  Hasilkan via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"]
VAULT_MASTER_KEY=

# Authentication Enforcement [EN: Set 'true' to require JWT authorization header on API endpoints.]
# Penegakan Otentikasi [ID: Set 'true' untuk mewajibkan header otorisasi JWT pada endpoint API.]
AUTH_REQUIRED=false

# Allowed CORS Origins [EN: Comma-separated list of allowed frontend origins.]
# Asal CORS yang Diizinkan [ID: Daftar asal frontend yang diizinkan, dipisahkan koma.]
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------------------------------------------
# 2. LLM & GATEWAY CONFIGURATION / KONFIGURASI LLM & GATEWAY
# ------------------------------------------------------------------------------

# Primary LLM API Key [EN: OpenAI-compatible API key or 9Router bearer token.]
# Kunci API LLM Utama [ID: Kunci API kompatibel OpenAI atau token bearer 9Router.]
LLM_API_KEY=

# LLM Base URL [EN: Endpoint URL for the LLM gateway or provider API.]
# URL Dasar LLM [ID: URL endpoint gateway LLM atau API penyedia.]
LLM_BASE_URL=https://api.openai.com/v1

# LLM Model Name [EN: Identifier of the primary chat completion model.]
# Nama Model LLM [ID: Pengenal model chat completion utama.]
LLM_MODEL_NAME=gpt-4o-mini

# LLM Chat Model Name [EN: Identifier of the dedicated conversational AI chat model.]
# Nama Model Chat LLM [ID: Pengenal model khusus interaksi percakapan AI chat.]
LLM_CHAT_MODEL_NAME=mirofish-agent


# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE / BASIS DATA & PERSISTENSI
# ------------------------------------------------------------------------------

# Relational Database URI (Supabase PostgreSQL / Self-Hosted PostgreSQL)
# [EN: Connection string in SQLAlchemy format using psycopg driver.]
# URI Basis Data Relasional (Supabase PostgreSQL / PostgreSQL Mandiri)
# [ID: String koneksi dalam format SQLAlchemy menggunakan driver psycopg.]
DATABASE_URI=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/postgres?options=-csearch_path%3Dmirofish,public


# ------------------------------------------------------------------------------
# 4. KNOWLEDGE GRAPH & CACHE / GRAF PENGETAHUAN & CACHE
# ------------------------------------------------------------------------------

# Knowledge Graph Backend [EN: Options: 'graphiti' (recommended), 'zep', 'hybrid'.]
# Backend Graf Pengetahuan [ID: Opsi: 'graphiti' (disarankan), 'zep', 'hybrid'.]
GRAPH_BACKEND=graphiti

# Neo4j Connection URI [EN: Bolt protocol URI for Neo4j graph database.]
# URI Koneksi Neo4j [ID: URI protokol Bolt untuk basis data graf Neo4j.]
NEO4J_URI=bolt://127.0.0.1:7687

# Neo4j Username [EN: Database user for Neo4j.]
# Nama Pengguna Neo4j [ID: Pengguna basis data untuk Neo4j.]
NEO4J_USER=neo4j

# Neo4j Password [EN: REQUIRED. Set strong password for Neo4j.]
# Kata Sandi Neo4j [ID: WAJIB DIISI. Set kata sandi yang kuat untuk Neo4j.]
NEO4J_PASSWORD=

# Redis Cache / Message Broker Host [EN: IP address or hostname of Redis server.]
# Host Redis Cache / Broker Pesan [ID: Alamat IP atau hostname server Redis.]
REDIS_HOST=127.0.0.1

# Redis Port [EN: Port number for Redis.]
# Port Redis [ID: Nomor port untuk Redis.]
REDIS_PORT=6379

# Redis Password [EN: REQUIRED in production. Authentication password for Redis.]
# Kata Sandi Redis [ID: WAJIB DIISI di lingkungan produksi. Kata sandi autentikasi Redis.]
REDIS_PASSWORD=

# FalkorDB URI [EN: Redis-compatible graph engine URI.]
# URI FalkorDB [ID: URI mesin graf kompatibel Redis.]
FALKORDB_URI=redis://127.0.0.1:6379
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379

# Graphiti Control Plane [EN: Orchestration and indexing plane for Graphiti.]
# Control Plane Graphiti [ID: Bidang orkestrasi dan pengindeksan untuk Graphiti.]
GRAPHITI_CONTROL_PLANE_URL=http://127.0.0.1:8080
GRAPHITI_CONTROL_PLANE_PORT=8090
GRAPHITI_GROUP_ID=main


# ------------------------------------------------------------------------------
# 5. WEB RESEARCH & METASEARCH / RISET WEB & METASEARCH
# ------------------------------------------------------------------------------

# SearXNG Research Toggle [EN: Enable or disable autonomous web research via SearXNG.]
# Saklar Riset SearXNG [ID: Aktifkan atau nonaktifkan riset web otonom via SearXNG.]
SEARXNG_ENABLED=true

# SearXNG Endpoint URL [EN: Base URL of the private SearXNG metasearch instance.]
# URL Endpoint SearXNG [ID: URL dasar dari instance metasearch privat SearXNG.]
SEARXNG_ENDPOINT=http://127.0.0.1:8088


# ------------------------------------------------------------------------------
# 6. SIMULATION & REASONING AGENTS / SIMULASI & AGEN PENALARAN
# ------------------------------------------------------------------------------

# OASIS Simulation Max Rounds [EN: Default maximum interaction rounds per simulation session.]
# Maksimal Putaran Simulasi OASIS [ID: Batas maksimal default putaran interaksi per sesi simulasi.]
OASIS_DEFAULT_MAX_ROUNDS=20

# Report Agent Max Tool Calls [EN: Max ReACT deduction tool calls per reflection round.]
# Maksimal Pemanggilan Tool Report Agent [ID: Batas pemanggilan tool ReACT per putaran refleksi.]
REPORT_AGENT_MAX_TOOL_CALLS=15

# Report Agent Reflection Rounds [EN: Max cycles of recursive deduction and fact-checking.]
# Putaran Refleksi Report Agent [ID: Siklus maksimal deduksi rekursif dan verifikasi fakta.]
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2

# Report Agent Sampling Temperature [EN: LLM creativity temperature (0.0=deterministic, 1.0=creative).]
# Temperatur Sampling Report Agent [ID: Suhu kreativitas LLM (0.0=deterministik, 1.0=kreatif).]
REPORT_AGENT_TEMPERATURE=0.5


# ------------------------------------------------------------------------------
# 7. EMBEDDING SERVICE / LAYANAN EMBEDDING
# ------------------------------------------------------------------------------

# Priority #1: Google TPU (bge-m3, 1024 dims) via 9Router
EMBEDDING_PRIMARY_BASE_URL=https://9router.biezz.my.id
EMBEDDING_PRIMARY_API_KEY=sk-dc3493f22a937c2c-h5uphp-1f3ca706
EMBEDDING_PRIMARY_MODEL=bge-m3/bge-m3
EMBEDDING_PRIMARY_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://9router.biezz.my.id
EMBEDDING_API_KEY=sk-dc3493f22a937c2c-h5uphp-1f3ca706
EMBEDDING_MODEL=bge-m3/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# Priority #2: Fallback Endpoint (when Primary TPU is offline / 5xx)
EMBEDDING_FALLBACK_BASE_URL=http://192.168.101.19:20128
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_MODEL=bge-m3/bge-m3
EMBEDDING_FALLBACK_DIMENSIONS=1024
EMBEDDING_FALLBACK_TIMEOUT_SECONDS=30
EMBEDDING_COOLDOWN_SECONDS=60

ENABLE_GRAPH_PREEMBEDDING=true


# ------------------------------------------------------------------------------
# 8. INTEGRATIONS & ALERTS / INTEGRASI & NOTIFIKASI
# ------------------------------------------------------------------------------

# Discord Webhook & Bot Token [EN: Optional channels for simulation alerts and report broadcast.]
# Webhook & Token Bot Discord [ID: Saluran opsional untuk notifikasi simulasi dan siaran laporan.]
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Webhook Worker Polling Interval [EN: Background worker sweep interval in seconds.]
# Interval Polling Worker Webhook [ID: Interval pemindaian worker latar belakang dalam detik.]
WEBHOOK_WORKER_POLL_INTERVAL=15

# Legacy Zep Cloud (Optional / Opsional)
ZEP_API_KEY=
ZEP_BASE_URL=https://api.getzep.com/api/v2
